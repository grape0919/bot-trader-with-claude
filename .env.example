# ─── Bitget API (필수) ───
BITGET_API_KEY=여기에_API_KEY_입력
BITGET_SECRET=여기에_SECRET_입력
BITGET_PASSPHRASE=여기에_PASSPHRASE_입력

# ─── Telegram 알림 (선택, 비워두면 알림 없음) ───
# 1. https://t.me/BotFather 에서 새 봇 생성 → 토큰 복사
# 2. 본인이 만든 봇과 대화 시작 ('/start' 발송)
# 3. https://api.telegram.org/bot<TOKEN>/getUpdates 에서 chat.id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Grafana 인증 (Compose 사용 시) ───
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme
