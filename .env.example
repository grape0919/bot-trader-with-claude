# ─── Bitget API (필수) ───
BITGET_API_KEY=여기에_API_KEY_입력
BITGET_SECRET=여기에_SECRET_입력
BITGET_PASSPHRASE=여기에_PASSPHRASE_입력

# ─── 알림 (선택, 비워두면 알림 없음. 여러 채널 동시 사용 가능) ───

# 옵션 A: ntfy.sh (권장 — 계정 X, 폰 앱만 설치)
#   1. 폰에 ntfy 앱 설치 (App Store / Play Store)
#   2. 앱에서 토픽 구독 — 추측 어려운 유니크 문자열 사용 (토픽 = 비밀번호)
#      예: bitget-trader-x4y9z-2026
#   3. 같은 토픽을 아래에 입력
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh                    # 셀프호스팅 시 변경

# 옵션 B: Telegram (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Grafana 인증 (Compose 사용 시) ───
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# ─── 대시보드 바인딩 IP (Tailscale 사용 시) ───
# 미설정 시 127.0.0.1 (서버 내부만). 외부에서 접근하려면 Tailscale IP 입력.
# 확인: tailscale ip -4
# BIND_IP=100.68.192.9
